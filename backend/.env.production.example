# Environment Configuration Template - Backend Laravel

# Application
APP_NAME="Sistem Absensi Sekolah"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://absensi-sekolah.duckdns.org

# Database
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=projek_absensi
DB_USERNAME=absensi_user
DB_PASSWORD=CHANGE_THIS_PASSWORD_123

# Cache & Session
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://absensi-sekolah.duckdns.org

# JWT Authentication
JWT_SECRET=GENERATE_THIS_SECRET_KEY

# Face Recognition Service URL
FACE_SERVICE_URL=http://face-service:8001

# File Storage
FILESYSTEM_DISK=local

# Absensi Configuration
ABSENSI_BATAS_MASUK=07:00
ABSENSI_FOTO_DISK=public
ABSENSI_FOTO_PATH=absensi

# Timezone
APP_TIMEZONE=Asia/Jakarta
